# Template for /etc/ddclient/ddclient.conf. Copy secrets/ddclient.conf
# (already filled in with the real tokens pulled from the live OPNsense
# config) to the router instead of starting from this template - this
# file exists so the repo has something safe to commit.

daemon=300
syslog=yes
ssl=yes

use=if, if=wan
protocol=cloudflare
zone=srvr.farm
ttl=300
password='REPLACE_WITH_CLOUDFLARE_API_TOKEN'
srvr.farm

use=if, if=wan
protocol=cloudflare
zone=REPLACE_WITH_ZONE_ID
login=REPLACE_WITH_ACCOUNT_OR_ZONE_ID
ttl=300
wildcard=yes
password='REPLACE_WITH_CLOUDFLARE_API_TOKEN'
crowdcomputing.io
