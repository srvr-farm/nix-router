# Copy this to /etc/pihole-webpassword.env ON THE ROUTER (not through the
# Nix store - see modules/pihole.nix) and fill in a real password. Never
# commit the filled-in version. The real file must be mode 0600, root-owned
# (matches secrets/ddclient.conf's deployment convention) - it holds a
# live credential.
FTLCONF_webserver_api_password=changeme
